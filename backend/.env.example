# Backend Production Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - add to .gitignore

# MongoDB Connection String
# Get this from MongoDB Atlas: Cluster → Connect → Drivers
MONGODB_URL=mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority

# Server Port (use 7000 for local, platform will assign port in production)
PORT=7000

# Environment
NODE_ENV=production

# Optional: Add frontend URL for CORS (uncomment if needed)
# FRONTEND_URL=https://your-frontend-domain.com

# Optional: Add other configuration as needed
